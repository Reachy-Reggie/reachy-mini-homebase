# Reggie Homebase Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control!

# AI Provider API Keys
VITE_ANTHROPIC_API_KEY=your-anthropic-key-here
VITE_OPENAI_API_KEY=your-openai-key-here
VITE_GOOGLE_API_KEY=your-google-ai-studio-key-here

# Robot Connection (optional - defaults shown)
# VITE_ROBOT_HOST=192.168.0.11
# VITE_ROBOT_PORT=8000

# Twilio Configuration (for SMS/Voice)
VITE_TWILIO_ACCOUNT_SID=your-twilio-account-sid
VITE_TWILIO_AUTH_TOKEN=your-twilio-auth-token
VITE_TWILIO_PHONE_NUMBER=+1234567890

# ElevenLabs Configuration (for real-time voice)
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key
VITE_ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
