# Reggie Twilio Webhook Server Configuration
# Copy this to .env and fill in your values

# Server Settings
PORT=3001
NODE_ENV=development

# Owner phone number (gets interactive voice calls, receives voicemail notifications)
OWNER_PHONE_NUMBER=+15037547138

# Twilio Credentials (from console.twilio.com)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Anthropic (for Claude responses)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ElevenLabs (for real-time voice - optional)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id

# Webhook Base URL (required for production)
# Set this after configuring port forwarding, ngrok, or cloudflare tunnel
# Example: https://your-domain.com or https://abc123.ngrok.io
WEBHOOK_BASE_URL=

# Dashboard URL (for CORS - adjust if dashboard runs elsewhere)
DASHBOARD_URL=http://localhost:5173

# Email (optional) - voicemail transcription notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_TO=
