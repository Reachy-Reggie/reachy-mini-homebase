[Unit]
Description=ngrok tunnel for Reachy Mini Homebase webhooks
After=network-online.target reachy-homebase.service
Wants=network-online.target
Requires=reachy-homebase.service

[Service]
Type=simple
# Replace with your username
User=YOUR_USERNAME

# Wait for server to be actually listening before starting ngrok
ExecStartPre=/bin/bash -c 'for i in {1..30}; do curl -sf http://localhost:3001/health && exit 0; sleep 1; done; exit 1'

# Start ngrok with static domain
# Replace YOUR_NGROK_DOMAIN with your ngrok static domain
ExecStart=/snap/bin/ngrok http 3001 --domain=YOUR_NGROK_DOMAIN.ngrok-free.dev

# Restart policy
Restart=always
RestartSec=10

# Prevent restart loops
StartLimitIntervalSec=120
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reachy-ngrok

[Install]
WantedBy=multi-user.target
